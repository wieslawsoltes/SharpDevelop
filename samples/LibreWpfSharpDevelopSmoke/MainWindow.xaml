<Window x:Class="LibreWpfSharpDevelopSmoke.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ad="clr-namespace:AvalonDock;assembly=AvalonDock"
        xmlns:ae="clr-namespace:ICSharpCode.AvalonEdit;assembly=ICSharpCode.AvalonEdit"
        xmlns:coreui="clr-namespace:ICSharpCode.Core.Presentation;assembly=ICSharpCode.Core.Presentation"
        xmlns:tree="clr-namespace:ICSharpCode.TreeView;assembly=ICSharpCode.TreeView"
        Title="LibreWPF SharpDevelop Smoke"
        Width="1180"
        Height="760"
        Loaded="OnLoaded">
  <DockPanel>
    <Menu DockPanel.Dock="Top" x:Name="MainMenu">
      <MenuItem Header="_File" x:Name="FileMenu">
        <MenuItem Header="_New" />
        <MenuItem Header="_Open..." />
        <Separator />
        <MenuItem Header="E_xit" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="_Undo" />
        <MenuItem Header="_Redo" />
        <Separator />
        <MenuItem Header="Cu_t" />
        <MenuItem Header="_Copy" />
        <MenuItem Header="_Paste" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_Project" IsCheckable="True" IsChecked="True" />
        <MenuItem Header="_Properties" IsCheckable="True" IsChecked="True" />
      </MenuItem>
    </Menu>

    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem Content="LibreWPF SharpDevelop popup smoke" />
      <Separator />
      <StatusBarItem x:Name="StatusText" Content="Starting" />
    </StatusBar>

    <ToolBarTray DockPanel.Dock="Top">
      <ToolBar>
        <Button Content="Context" Click="OpenTreeContextMenu" />
        <Button Content="Combo" Click="OpenComboDropDown" />
        <coreui:DropDownButton x:Name="CoreDropDown" Content="Core menu" Width="96">
          <coreui:DropDownButton.DropDownMenu>
            <ContextMenu x:Name="CoreDropDownMenu">
              <MenuItem Header="Run" />
              <MenuItem Header="Build" />
              <Separator />
              <MenuItem Header="Options" />
            </ContextMenu>
          </coreui:DropDownButton.DropDownMenu>
        </coreui:DropDownButton>
        <ComboBox x:Name="ModeCombo" Width="180" SelectedIndex="0">
          <ComboBoxItem Content="Debug" />
          <ComboBoxItem Content="Release" />
          <ComboBoxItem Content="Any CPU" />
        </ComboBox>
      </ToolBar>
    </ToolBarTray>

    <ad:DockingManager x:Name="DockManager">
      <ad:ResizingPanel Orientation="Horizontal">
        <ad:DockablePane ad:ResizingPanel.ResizeWidth="260">
          <ad:DockableContent Title="Project">
            <tree:SharpTreeView x:Name="ProjectTree" Margin="8" ShowRoot="False" ShowRootExpander="False">
              <tree:SharpTreeView.ContextMenu>
                <ContextMenu x:Name="ProjectContextMenu">
                  <MenuItem Header="Build" />
                  <MenuItem Header="Clean" />
                  <Separator />
                  <MenuItem Header="Properties" />
                </ContextMenu>
              </tree:SharpTreeView.ContextMenu>
            </tree:SharpTreeView>
          </ad:DockableContent>
        </ad:DockablePane>

        <ad:DocumentPane>
          <ad:DocumentContent Title="Editor.cs">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <TextBlock Margin="8" Text="AvalonEdit from SharpDevelop source, hosted inside AvalonDock." />
              <ae:TextEditor x:Name="Editor"
                             Grid.Row="1"
                             FontFamily="Menlo"
                             FontSize="14"
                             ShowLineNumbers="True"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto" />
            </Grid>
          </ad:DocumentContent>
          <ad:DocumentContent Title="Output">
            <ListBox x:Name="OutputList" Margin="8">
              <ListBoxItem Content="Build started" />
              <ListBoxItem Content="Restore completed" />
              <ListBoxItem Content="Popup smoke active" />
            </ListBox>
          </ad:DocumentContent>
        </ad:DocumentPane>

        <ad:DockablePane ad:ResizingPanel.ResizeWidth="260">
          <ad:DockableContent Title="Properties">
            <Grid Margin="8">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <TextBlock Text="Configuration" />
              <ComboBox x:Name="PropertiesCombo" Grid.Row="1" Margin="0,6,0,10" SelectedIndex="0">
                <ComboBoxItem Content="Application" />
                <ComboBoxItem Content="Build" />
                <ComboBoxItem Content="Debug" />
              </ComboBox>
              <ListView Grid.Row="2">
                <ListViewItem Content="TargetFramework: net10.0-windows" />
                <ListViewItem Content="SDK: LibreWPF.Sdk" />
                <ListViewItem Content="Renderer: ProGPU" />
              </ListView>
            </Grid>
          </ad:DockableContent>
        </ad:DockablePane>
      </ad:ResizingPanel>
    </ad:DockingManager>
  </DockPanel>
</Window>
