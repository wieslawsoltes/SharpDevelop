<Project Sdk="LibreWPF.Sdk/0.1.0-preview.10">
  <PropertyGroup>
    <TargetFramework>$(ProGpuWpfSdkSampleTargetFramework)</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>ICSharpCode.Reporting</AssemblyName>
    <RootNamespace>ICSharpCode.Reporting</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <LangVersion>12.0</LangVersion>
    <NoWarn>$(NoWarn);1591;CS1591;CS0618;SYSLIB0050;SYSLIB0051;NU1603</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="obj/**" />
    <EmbeddedResource Remove="obj/**" />
    <None Remove="obj/**" />
    <Page Remove="obj/**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Src/**/*.cs" />
    <Compile Include="../../../../Main/GlobalAssemblyInfo.cs" Link="Configuration/GlobalAssemblyInfo.cs" />
    <Page Include="Src/Wpf/WpfReportViewer/WpfReportViewer.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="ProGPU.System.Drawing.Common" Version="$(ProGpuWpfSdkVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Drawing.Common"
               HintPath="$(NuGetPackageRoot)progpu.system.drawing.common/$(ProGpuWpfSdkVersion)/lib/net10.0/System.Drawing.Common.dll"
               Private="true"
               Condition="Exists('$(NuGetPackageRoot)progpu.system.drawing.common/$(ProGpuWpfSdkVersion)/lib/net10.0/System.Drawing.Common.dll')" />
    <Reference Include="Irony" HintPath="../Libraries/Irony.dll" Private="true" />
    <Reference Include="Irony.Interpreter" HintPath="../Libraries/Irony.Interpreter.dll" Private="true" />
  </ItemGroup>
</Project>
