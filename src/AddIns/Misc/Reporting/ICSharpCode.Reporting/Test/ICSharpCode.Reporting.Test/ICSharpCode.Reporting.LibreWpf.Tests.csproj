<Project Sdk="LibreWPF.Sdk/0.1.0-preview.10">
  <PropertyGroup>
    <TargetFramework>$(ProGpuWpfSdkSampleTargetFramework)</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>ICSharpCode.Reporting.Tests</AssemblyName>
    <RootNamespace>ICSharpCode.Reporting.Test</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <DefineConstants>$(DefineConstants);LIBREWPF</DefineConstants>
    <NoWarn>$(NoWarn);1591;CS1591;CS0618;NU1603</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/**/*.cs" Exclude="src/Properties/AssemblyInfo.cs" />
    <EmbeddedResource Include="src/TestReports/*.srd" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="ProGPU.System.Drawing.Common" Version="$(ProGpuWpfSdkVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Irony" HintPath="../../../Libraries/Irony.dll" Private="true" />
    <Reference Include="Irony.Interpreter" HintPath="../../../Libraries/Irony.Interpreter.dll" Private="true" />
    <Reference Include="System.Drawing.Common"
               HintPath="$(NuGetPackageRoot)progpu.system.drawing.common/$(ProGpuWpfSdkVersion)/lib/net10.0/System.Drawing.Common.dll"
               Private="true"
               Condition="Exists('$(NuGetPackageRoot)progpu.system.drawing.common/$(ProGpuWpfSdkVersion)/lib/net10.0/System.Drawing.Common.dll')" />
    <ProjectReference Include="../../ICSharpCode.Reporting.LibreWpf.csproj" />
  </ItemGroup>
</Project>
