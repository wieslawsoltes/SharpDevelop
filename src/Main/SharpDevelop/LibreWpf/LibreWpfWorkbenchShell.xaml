<Window x:Class="ICSharpCode.SharpDevelop.Workbench.LibreWpfWorkbenchShell"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ad="clr-namespace:AvalonDock;assembly=AvalonDock"
        xmlns:ae="clr-namespace:ICSharpCode.AvalonEdit;assembly=ICSharpCode.AvalonEdit"
        xmlns:coreui="clr-namespace:ICSharpCode.Core.Presentation;assembly=ICSharpCode.Core.Presentation"
        xmlns:tree="clr-namespace:ICSharpCode.TreeView;assembly=ICSharpCode.TreeView"
        Title="SharpDevelop LibreWPF"
        Width="1240"
        Height="820"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded">
  <DockPanel>
    <Menu x:Name="MainMenu" DockPanel.Dock="Top">
      <MenuItem x:Name="FileMenu" Header="_File">
        <MenuItem Header="_New Solution" />
        <MenuItem Header="_Open..." />
        <MenuItem Header="Open _Recent">
          <MenuItem Header="SharpDevelop.sln" />
          <MenuItem Header="LibreWPF smoke workspace" />
        </MenuItem>
        <Separator />
        <MenuItem Header="E_xit" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="_Undo" />
        <MenuItem Header="_Redo" />
        <Separator />
        <MenuItem Header="Cu_t" />
        <MenuItem Header="_Copy" />
        <MenuItem Header="_Paste" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_Projects" IsCheckable="True" IsChecked="True" />
        <MenuItem Header="_Properties" IsCheckable="True" IsChecked="True" />
        <MenuItem Header="_Output" IsCheckable="True" IsChecked="True" />
      </MenuItem>
      <MenuItem Header="_Project">
        <MenuItem Header="_Build" />
        <MenuItem Header="_Clean" />
        <MenuItem Header="_Properties" />
      </MenuItem>
      <MenuItem Header="_Tools">
        <MenuItem Header="_Options" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_About SharpDevelop LibreWPF" />
      </MenuItem>
    </Menu>

    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem Content="SharpDevelop LibreWPF shell" />
      <Separator />
      <StatusBarItem x:Name="StatusText" Content="Starting" />
    </StatusBar>

    <ToolBarTray DockPanel.Dock="Top">
      <ToolBar>
        <coreui:DropDownButton x:Name="BuildDropDown" Content="Build" Width="82">
          <coreui:DropDownButton.DropDownMenu>
            <ContextMenu x:Name="BuildDropDownMenu">
              <MenuItem Header="Build Solution" />
              <MenuItem Header="Rebuild Solution" />
              <MenuItem Header="Clean Solution" />
            </ContextMenu>
          </coreui:DropDownButton.DropDownMenu>
        </coreui:DropDownButton>
        <Button Content="Context" Click="OpenProjectContextMenu" />
        <Button Content="Combo" Click="OpenConfigurationCombo" />
        <Button Content="Completion" Click="OpenCompletionWindow" />
        <Separator />
        <ComboBox x:Name="ConfigurationCombo" Width="140" SelectedIndex="0">
          <ComboBoxItem Content="Debug" />
          <ComboBoxItem Content="Release" />
          <ComboBoxItem Content="Debug Portable" />
        </ComboBox>
        <ComboBox x:Name="PlatformCombo" Width="140" SelectedIndex="0">
          <ComboBoxItem Content="Any CPU" />
          <ComboBoxItem Content="arm64" />
          <ComboBoxItem Content="x64" />
        </ComboBox>
      </ToolBar>
    </ToolBarTray>

    <ad:DockingManager x:Name="DockManager">
      <ad:ResizingPanel Orientation="Horizontal">
        <ad:DockablePane ad:ResizingPanel.ResizeWidth="280">
          <ad:DockableContent Title="Projects">
            <tree:SharpTreeView x:Name="ProjectTree" Margin="8" ShowRoot="False" ShowRootExpander="False">
              <tree:SharpTreeView.ContextMenu>
                <ContextMenu x:Name="ProjectContextMenu">
                  <MenuItem Header="Build" />
                  <MenuItem Header="Clean" />
                  <Separator />
                  <MenuItem Header="Add New Item..." />
                  <MenuItem Header="Properties" />
                </ContextMenu>
              </tree:SharpTreeView.ContextMenu>
            </tree:SharpTreeView>
          </ad:DockableContent>
        </ad:DockablePane>

        <ad:DocumentPane>
          <ad:DocumentContent x:Name="ProgramDocument" Title="Program.cs">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <TextBlock Margin="8" Text="SharpDevelop editor surface running through LibreWPF and ProGPU." />
              <ae:TextEditor x:Name="Editor"
                             Grid.Row="1"
                             FontFamily="Menlo"
                             FontSize="14"
                             ShowLineNumbers="True"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto" />
            </Grid>
          </ad:DocumentContent>
          <ad:DocumentContent x:Name="OutputDocument" Title="Output">
            <ListBox x:Name="OutputList" Margin="8">
              <ListBoxItem Content="LibreWPF SDK loaded" />
              <ListBoxItem Content="ProGPU renderer active" />
              <ListBoxItem Content="SharpDevelop shell lane ready" />
            </ListBox>
          </ad:DocumentContent>
        </ad:DocumentPane>

        <ad:DockablePane ad:ResizingPanel.ResizeWidth="280">
          <ad:DockableContent Title="Properties">
            <Grid Margin="8">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <TextBlock Text="Target" />
              <ComboBox x:Name="TargetCombo" Grid.Row="1" Margin="0,6,0,10" SelectedIndex="0">
                <ComboBoxItem Content="SharpDevelop.LibreWpf" />
                <ComboBoxItem Content="ICSharpCode.Core" />
                <ComboBoxItem Content="AvalonDock" />
              </ComboBox>
              <ListView Grid.Row="2">
                <ListViewItem Content="SDK: LibreWPF.Sdk" />
                <ListViewItem Content="Renderer: ProGPU" />
                <ListViewItem Content="Windowing: Silk.NET" />
              </ListView>
            </Grid>
          </ad:DockableContent>
        </ad:DockablePane>
      </ad:ResizingPanel>
    </ad:DockingManager>
  </DockPanel>
</Window>
